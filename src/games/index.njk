---
layout: base.njk
title: Games
---


<div class="egg-grid-wrap games-grid-stop-mid relative overflow-hidden" data-games-page>

  <div class="relative z-30 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-12">
    {% include "partials/navbar.njk" %}

    <div
    class="absolute
            right-[-100px] sm:right-[-80px] md:right-[-80px]       
            lg:right-[-50px]                    
            top-[150px] sm:top-[50px]
            h-[250px] w-[250px]
            md:h-[250px] md:w-[250px]
            rounded-full bg-limeEgg/50 blur-[185px] md:blur-[185px]"
    ></div>

    <div
    class="absolute
            left-[-200px] sm:left-[-80px] md:left-[-80px]       
            lg:left-[-50px]                    
            top-[300px] sm:top-[450px]
            h-[180px] w-[180px]
            rounded-full bg-limeEgg/50 blur-[150px] md:blur-[180px]"
    ></div>

    <div
    class="absolute
            right-[-200px] sm:right-[-80px] md:right-[-80px]       
            lg:right-[-50px]                    
            top-[30px] sm:top-[150px]
            h-[180px] w-[180px]
            rounded-full bg-limeEgg/50 blur-[150px] md:blur-[180px]"
    ></div>

    <!-- Heading -->
    <div class="text-center">

      <h1 class="mx-auto mt-12 max-w-3xl text-3xl sm:text-5xl lg:text-6xl leading-[1.25] sm:leading-[1.3] lg:leading-[1.35] font-semibold text-white text-center">
        Explore All <span class="text-limeEgg">Games</span> by
        <span class="block">
            Category and Passion
        </span>
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-white/60">
        Dive into curated game worlds designed to match<br class="hidden sm:block" />
        your style, mood, and play preferences.
      </p>
    </div>

    <!-- Filter Row -->
    <div class="mt-20 flex flex-col gap-4 sm:gap-6 lg:flex-row lg:items-center lg:justify-between">
      <!-- Tabs -->
      <div class="overflow-hidden">
        <div class="-mx-4 sm:mx-0">
            <div
                class="relative z-10 flex flex-nowrap items-center gap-3 overflow-x-auto px-4 sm:px-0
                      whitespace-nowrap scrollbar-hide [-webkit-overflow-scrolling:touch]"
              >
                <button
                  class="games-tab relative z-20 shrink-0 inline-flex items-center rounded-xl px-5 py-2 text-base font-medium transition
                        bg-limeEgg text-black hover:brightness-105"
                  data-category="All"
                  aria-pressed="true"
                >
                  All
                </button>

                <button
                class="games-tab shrink-0 inline-flex items-center rounded-xl px-5 py-2 text-base font-medium transition
                        !bg-[#181a26] text-white/80 
                        hover:bg-white/10 hover:text-white"
                data-category="Action"
                aria-pressed="false">
                Action
                </button>

                <button
                class="games-tab shrink-0 inline-flex items-center rounded-xl px-5 py-2 text-base font-medium transition
                        !bg-[#181a26] text-white/80 
                        hover:bg-white/10 hover:text-white"
                data-category="Adventure"
                aria-pressed="false">
                Adventure
                </button>

                <button
                class="games-tab shrink-0 inline-flex items-center rounded-xl px-5 py-2 text-base font-medium transition
                        !bg-[#181a26] text-white/80 
                        hover:bg-white/10 hover:text-white"
                data-category="Puzzle"
                aria-pressed="false">
                Puzzle
                </button>

                <button
                class="games-tab shrink-0 inline-flex items-center rounded-xl px-5 py-2 text-base font-medium transition
                        !bg-[#181a26] text-white/80 
                        hover:bg-white/10 hover:text-white"
                data-category="Strategy"
                aria-pressed="false" >
                Strategy
                </button>
            </div>
        </div>
      </div>

      <!-- Search -->
      <div class="w-full lg:w-[240px]">
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-white/50">
            <!-- search icon -->
            <i class="bi bi-search"></i>
          </span>

          <input
            id="gamesSearch"
            type="text"
            placeholder="Search"
            class="w-full rounded-xl !bg-[#181a26] pl-11 pr-4 py-2.5 text-base text-white placeholder:text-white/45
            focus:outline-none focus:ring-2 focus:ring-limeEgg/40"
          />
        </div>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
    
      <!-- Card 1 -->
      <article
        class="games-card job-card group rounded-3xl !bg-[#141622]
              overflow-hidden backdrop-blur-md transition hover:bg-white/7"
        data-category="Action"
        data-title="Lorem ipsum orci">
        <!-- inner padding wrapper (ini yang bikin ada frame/padding) -->
        <div class="p-4">
          <!-- image frame -->
          <div class="relative aspect-[4/3] overflow-hidden rounded-2xl">
            <img
              src="/assets/img/games/games-1.png"
              alt="Game"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />

            <!-- badge date -->
            <div
              class="absolute right-3 top-3 flex items-center gap-2
                    rounded-lg bg-black/35 px-2.5 py-1 text-md text-white/80"
            >
              <i class="bi bi-calendar3 opacity-90"></i>
              <span>OCT 07, 5:10 AM</span>
            </div>
          </div>

          <!-- content -->
          <div class="pt-5">
            <h3 class="text-2xl font-medium text-white">Lorem ipsum orci</h3>
            <p class="mt-2 text-base text-white/60 line-clamp-2">
              Lorem ipsum dolor sit amet consectetur. Ut eget donec vel...
            </p>

            <!-- CTA -->
            <div
              class="mt-5 flex items-center justify-between rounded-xl
                    bg-[#FFF6451A] px-4 py-3
                    ring-1 ring-white/10"
            >
              <a href="#" class="text-base font-medium text-white/85 hover:text-white transition">
                See Details
              </a>

              <a
                href="#"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full
                      bg-limeEgg text-black
                      shadow-[0_0_0_1px_rgba(163,230,53,0.35)]
                      hover:brightness-105 transition"
                aria-label="See details"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M9 18 15 12 9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </article>

