<!-- FAQ SECTION -->
{% set faqs = [
  {
    q: "How can I stay connected with the latest news from Eggine Studio?",
    a: "You can stay updated with Eggine Studio's latest news by following our official social media channels, subscribing to our newsletter on our website, and keeping an eye on our press releases."
  },
  { q: "What is Eggine Studio?", a: "Eggine Studio is a creative game studio focused on immersive worlds, polished gameplay, and meaningful player experiences." },
  { q: "What kind of games does Eggine Studio develop?", a: "We build story-driven adventures and stylized experiences that blend exploration, creativity, and community features." },
  { q: "When will Eggine's next game be released?", a: "We announce release windows on our official channels. Subscribe to the newsletter for early updates and closed testing opportunities." },
  { q: "Does Eggine Studio offer internships?", a: "Yes. We open internship applications during specific periods. Check the Career page and our social channels for announcements." }
] %}
<section class="mt-20 sm:mt-24" data-faq-swap>
  <div class="grid lg:grid-cols-12 gap-4 sm:gap-10 items-center">
    <div class="lg:col-span-7">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium sm:leading-[1.18] lg:leading-[1.2] text-white">
        All You Need to Know
        <span class="block">About <span class="text-limeEgg">Eggine</span></span>
      </h2>
    </div>

    <div class="lg:col-span-5">
      <p class="text-sm sm:text-base text-white/55 leading-relaxed">
        Discover Eggine Studio’s mission team and creative process that drive our games,
        our vision and how we bring imagination to reality.
      </p>
    </div>
  </div>

  <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- LEFT: Expanded -->
    <article
      class="faq-big faq-big-card lg:col-span-5 rounded-2xl bg-white/5 ring-1 ring-white/10 p-6"
      data-faq-role="big"
      data-q="{{ faqs[0].q | escape }}"
      data-a="{{ faqs[0].a | escape }}">
      <div class="flex items-start gap-4">
        <div class="h-12 w-12 rounded-full bg-[#FFF6451A] ring-1 ring-white/10 flex items-center justify-center text-limeEgg shrink-0">
          <i class="bi bi-dash text-2xl"></i>
        </div>

        <div class="min-w-0">
          <h3 class="text-lg font-medium text-white/90 leading-snug" data-faq-q>{{ faqs[0].q }}</h3>
          <p class="mt-5 text-base text-white/55 leading-relaxed" data-faq-a>{{ faqs[0].a }}</p>
        </div>
      </div>

    </article>

    <!-- RIGHT: 2x2 small cards -->
    <div class="lg:col-span-7 min-w-0">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {% for item in faqs %}
          {% if loop.index0 != 0 %}
          <article
            class="faq-small faq-small-card rounded-2xl bg-white/5 ring-1 ring-white/10 p-6 cursor-pointer select-none flex items-center"
            data-faq-role="small"
            data-q="{{ item.q | escape }}"
            data-a="{{ item.a | escape }}">
            <div class="flex items-center gap-4">
              <div class="h-12 w-12 rounded-full bg-[#FFF6451A] ring-1 ring-white/10 flex items-center justify-center text-limeEgg shrink-0">
                <i class="bi bi-plus text-2xl"></i>
              </div>
              <h3 class="text-lg font-medium text-white/90 leading-snug" data-faq-q>{{ item.q }}</h3>
            </div>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>




  </div>

  {% include "partials/footer.njk" %}
</div>
