{# WRAPPER GRID: hanya untuk HERO + GAMES #}
<div class="egg-grid-wrap">

   <!-- GLOW (ONLY INDEX) -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <!-- kiri -->
    <div
      class="absolute lg:left-140  2xl:left-40  top-[200px]
             h-[300px] w-[300px]
             sm:h-[400px] sm:w-[400px]
             lg:h-[300px] lg:w-[300px]
             rounded-full
             bg-limeEgg/50
             blur-[170px]"
    ></div>

     <!-- kanan -->
    <div
      class="absolute hidden lg:flex -right-40 md:right-80 top-[350px]
             h-[640px] w-[640px]
             sm:h-[620px] sm:w-[620px]
             lg:h-[300px] lg:w-[300px]
             rounded-full
             bg-orange-500/20
             blur-[140px]"
    ></div>
  </div>

  <!-- HERO -->
  <section class="relative ">
  <!-- CONTENT -->
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-12">
      {% include "partials/navbar.njk" %}

      <div class="mt-10 sm:mt-12 lg:mt-5 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left -->
        <div class="lg:col-span-6">
          <div class="mb-5">
            <img
              src="/assets/img/dots.png"
              alt="decorative dots"
              class="h-8 sm:h-9 w-auto object-contain"
            />
          </div>

          <h1 class="font-semibold leading-[1.15] sm:leading-[1.18] lg:leading-[1.2] text-4xl sm:text-5xl lg:text-6xl">
            Crafting <span class="text-limeEgg">Games</span><br class="hidden sm:block" />
            with Heart and<br class="hidden sm:block" />
            Innovation
          </h1>

          <p class="mt-6 max-w-lg text-white/55 text-sm sm:text-lg leading-relaxed">
            Blending emotion and engineering, we build game experiences that feel alive and play beautifully.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4">
            <a href="#" class="inline-flex items-center justify-center h-12 px-6 rounded-xl bg-limeEgg text-black text-lg font-semibold shadow-soft hover:brightness-95 transition">
              Get Started
            </a>

            <a href="#" class="inline-flex items-center justify-center h-12 px-6 rounded-xl glass subtle-outline text-lg text-white/85 hover:text-white transition">
              Behind the Studio
            </a>
          </div>
        </div>

        <!-- Right -->
        <div class="lg:col-span-6 relative">
          <!-- Decorative Arrow -->
          <div class="absolute left-[-120px] top-[220px]">
            <img
              src="/assets/img/arrow.png"
              alt="decorative arrow"
              class="w-12 h-auto object-contain"
            />
          </div>

          <div class="relative mx-auto max-w-[560px] lg:-ml-6">
            <div class="absolute inset-0 -z-10 blur-2xl opacity-70"
                 style="background: radial-gradient(closest-side, rgba(201,242,110,.18), transparent 65%);"></div>

            <img
              data-hero="true"
              src="/assets/img/hero.png"
              alt="Hero Character"
              class="w-full h-auto drop-shadow-[0_35px_60px_rgba(0,0,0,.65)]"
            />

            <div class="rounded-3xl glass subtle-outline p-6 text-white/70 hidden" id="fallbackCard">
              Taruh gambar karakter di: <b>src/assets/img/hero.png</b>
            </div>

            <!-- Mini avatars -->
            <div class="absolute right-0 bottom-[270px] flex items-center gap-2 glass subtle-outline rounded-2xl px-3 py-2">
              <img class="h-12 w-12 rounded-xl object-cover" src="/assets/img/av1.png" alt="avatar 1" />
              <img class="h-12 w-12 rounded-xl object-cover" src="/assets/img/av2.png" alt="avatar 2" />
            </div>

            <!-- Winners card -->
            <div class="absolute right-0 bottom-2 w-[240px] sm:w-[200px] glass subtle-outline rounded-2xl p-4 shadow-soft">
              <div class="flex items-center gap-2 text-lg font-medium text-white/90">
                <span class="inline-flex h-2 w-2 rounded-full bg-limeEgg"></span>
                <span class="text-white/80">Last Winners</span>
              </div>

              <div class="mt-2 h-px bg-white/50"></div>

              <div class="mt-4 space-y-3">
                <div class="flex items-center gap-3">
                  <img class="h-12 w-12 rounded-xl object-cover" src="/assets/img/w1.png" alt="Nilo" />
                  <div>
                    <div class="text-lg font-medium text-white/90 leading-tight">Nilo Arven</div>
                    <div class="text-base text-limeEgg/90">+$305</div>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <img class="h-12 w-12 rounded-xl object-cover" src="/assets/img/w2.png" alt="Elva" />
                  <div>
                    <div class="text-lg font-medium text-white/90 leading-tight">Elva Aurelia</div>
                    <div class="text-base text-limeEgg/90">+$500</div>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <img class="h-12 w-12 rounded-xl object-cover" src="/assets/img/w3.png" alt="Jo" />
                  <div>
                    <div class="text-lg font-medium text-white/90 leading-tight">Jo Celeste</div>
                    <div class="text-base text-limeEgg/90">+$220</div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION: Game We Built -->
