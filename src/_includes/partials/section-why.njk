{# SECTION: Why Gamers Choose Eggine Studio #}
<section class="relative pt-6 sm:pt-10 lg:pt-12 pb-16 sm:pb-20 games-grid-stop">
  <div class="absolute inset-0 pointer-events-none">
    <div class="mx-auto max-w-7xl h-full px-4 sm:px-6 lg:px-8">
      <div class="h-full rounded-[36px] opacity-70 blur-2xl"
           style="background: radial-gradient(900px 520px at 18% 20%, rgba(255,246,69,.12), transparent 62%),
                  radial-gradient(900px 520px at 70% 28%, rgba(255,120,80,.10), transparent 62%);"></div>
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 lg:gap-10">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium sm:leading-[1.18] lg:leading-[1.2] text-white">
        Why <span class="text-limeEgg">Gamers</span> Choose<br />
        Eggine Studio
      </h2>

      <p class="max-w-xl text-white/55 text-sm sm:text-base leading-relaxed lg:pt-2">
        We earn players’ trust by listening deeply, creating transparently, and crafting games they truly love with passion, purpose, and a deep respect for play.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-7">
      <!-- Card 1 -->
      <article class="why-card job-card !bg-[#141622] lg:col-span-8">
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">
            
            <!-- TEXT -->
            <div class="max-w-md">
            <h3 class="text-xl sm:text-2xl font-medium text-white">
                Trusted by Gamers,<br class="hidden sm:block" />
                Built for You
            </h3>

            <p class="mt-3 text-white/55 text-sm sm:text-base leading-relaxed">
                Players trust us because we craft meaningful games with care, clarity, and community focus.
            </p>

            <a
                href="#"
                class="mt-6 inline-flex items-center justify-center h-11 px-5 rounded-xl glass subtle-outline text-white/85 hover:text-limeEgg transition"
            >
                See Top Game
            </a>
            </div>

            <!-- IMAGE -->
            <div class="flex w-full sm:w-[320px] lg:w-[360px] items-center justify-end">
              <div class="relative w-full max-w-[320px] lg:max-w-[360px]">
                <!-- Glow layer -->
                <div
                  class="pointer-events-none absolute inset-0
                        -z-10
                        rounded-full
                        bg-limeEgg/30
                        blur-[60px]
                        scale-90"
                ></div>

                <!-- Image -->
                <img
                  src="/assets/img/why1.png"
                  alt="trust icons"
                  class="w-full h-auto object-contain
                        drop-shadow-[0_18px_35px_rgba(0,0,0,.45)]"
                />
              </div>
            </div>


        </div>
      </article>


      <!-- Card 2 -->
      <article class="why-card job-card !bg-[#141622] text-center lg:col-span-4">
        <div class="relative z-10">
          <div class="space-y-2">
            <div class="why-pill"><i class="bi bi-chat-dots"></i><span>Absolutely love this!</span></div>
            <div class="why-pill"><i class="bi bi-chat-dots"></i><span>Feels real and immersive</span></div>
            <div class="why-pill"><i class="bi bi-chat-dots"></i><span>Best game ever!</span></div>
          </div>

          <h3 class="mt-8 text-xl sm:text-2xl font-medium text-white">Always Listening</h3>
          <p class="mt-3 text-white/55 text-sm sm:text-base leading-relaxed">
            We value feedback to shape better, player-first experiences.
          </p>
        </div>
      </article>

        <!-- Card 3 -->
      <article class="why-card job-card !bg-[#141622] lg:col-span-4 min-h-[220px] sm:min-h-[240px] flex flex-col items-center text-center">
        <div class="relative z-10 max-w-sm">
            <h3 class="text-xl sm:text-2xl font-medium text-white">
            Transparency
            </h3>
            <p class="mt-3 text-white/55 text-sm sm:text-base leading-relaxed">
            We share every decision to build honest, player-centered experiences.
            </p>
        </div>

        <!-- IMAGE -->
        <div class="mt-auto flex items-end justify-center w-full pt-6 -mb-7">
            <img
            src="/assets/img/why2.png"
            alt="transparency illustration"
            class="w-[220px] sm:w-[240px] lg:w-[260px] h-auto object-contain
                    drop-shadow-[0_26px_45px_rgba(0,0,0,.5)]"
            />
        </div>

      </article>

        <!-- Card 4 -->
      <article class="why-card job-card !bg-[#141622] lg:col-span-8 overflow-hidden">
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">

            <!-- TEXT -->
            <div class="max-w-md">
            <h3 class="text-xl sm:text-2xl font-medium text-white">
                Discover Games You’ll<br class="hidden sm:block" />
                Actually Love
            </h3>

            <p class="mt-3 text-white/55 text-sm sm:text-base leading-relaxed">
                Our games are thoughtfully selected to deliver meaningful, memorable, and enjoyable experiences tailored specifically for real players.
            </p>

            <a href="#"
                class="mt-6 inline-flex items-center justify-center h-11 px-5 rounded-xl glass subtle-outline text-white/85 hover:text-limeEgg transition">
                Find Your Game
            </a>
            </div>

            <!-- IMAGE (in-flow) -->
            <div class="flex w-full sm:w-[360px] lg:w-[440px] items-end justify-end -mb-7 -mr-7">
              <div class="relative w-full max-w-[360px] lg:max-w-[440px]">
                <!-- Glow layer -->
                <div
                  class="pointer-events-none absolute inset-0
                        -z-10
                        rounded-full
                        bg-limeEgg/25
                        blur-[80px]
                        scale-90"
                ></div>

                <!-- Image -->
                <img
                  src="/assets/img/why3.png"
                  alt="discover illustration"
                  class="w-full h-auto object-contain
                        drop-shadow-[0_30px_55px_rgba(0,0,0,.5)]"
                />
              </div>
            </div>


        </div>
      </article>

    </div>
  </div>
</section>
